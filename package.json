{
    "name": "noteforge-ai",
    "private": true,
    "version": "0.1.0",
    "packageManager": "npm@10.9.3",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm run dev --workspace @noteforge/web",
        "dev:api": "npm run dev --workspace @noteforge/api",
        "build": "npm run build --workspaces",
        "typecheck": "npm run typecheck --workspaces",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.5",
        "eslint": "^9.17.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
